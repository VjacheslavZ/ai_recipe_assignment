*.db
*.db-journal
*.db-wal
*.db-shm

# Pipeline runs are committed (artifacts of every run); the zip is rebuilt from
# 05_review/ on download, and scratch folders stay local.
runs/*/05_review/posts.zip
runs/_tmp/
runs/_scratch/

# OS / editors
.DS_Store
.idea/
.vscode/
*.log

