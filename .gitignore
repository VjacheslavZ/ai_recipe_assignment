# Dependencies & build output
node_modules/
dist/
*.tsbuildinfo
coverage/

# Secrets — only .env.example is committed
.env
.env.*
!.env.example

# SQLite database (lives in data/, folder is kept)
data/*
!data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# Pipeline runs: ignored; the final demo run is committed as part of the
# submission by adding an exception for it here (!runs/<runId>/).
runs/*
!runs/.gitkeep

# OS / editors
.DS_Store
.idea/
.vscode/
*.log

AI_Recipe_Assignment.md
AI_Recipe_Assignment_EN.pdf
# Browser automation output
.playwright-mcp/
