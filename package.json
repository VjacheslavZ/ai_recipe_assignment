{
  "name": "ai-recipe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI recipe: from an Instagram brand to three finished Instagram posts.",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "dev:server": "tsx watch --conditions=source packages/server/src/index.ts",
    "dev:web": "pnpm --filter @recipe/web dev",
    "recipe": "tsx --conditions=source packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
