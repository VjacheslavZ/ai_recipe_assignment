# Copy to .env and fill in. Never commit real keys.

# AI provider: openai | mock.
#   openai = real runs through the OpenAI API (needs OPENAI_API_KEY).
#   mock   = offline fixtures, no key and no cost; checks the app wiring only.
AI_PROVIDER=openai

# OpenAI API key. Never commit it; .env is git-ignored.
OPENAI_API_KEY=

# Model IDs — verify current model IDs at https://developers.openai.com/api/docs/models
# Defaults are the cheapest models, for development/testing (checked 2026-10-30).
# Recommended for the final run: OPENAI_TEXT_MODEL=gpt-6.1-sol, OPENAI_VISION_MODEL=gpt-6.1-terra,
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare.
# Text model for brief/analysis/planning (Responses API, structured outputs, web_search tool).
# gpt-6-luna: $0.10 / $0.50 per 1M tokens, cheapest current (non-deprecated) model; text + image input.
OPENAI_TEXT_MODEL=gpt-6.1-sol
# Vision model for Instagram screenshot analysis and QA review.
OPENAI_VISION_MODEL=gpt-6.1-sol
# Image model for post backgrounds (see BACKGROUND_MODE; the real product is always composited on top).
# gpt-image-1-mini: $2.50 / $8 per 1M image tokens (vs $8 / $30 for gpt-image-2.5-flare).
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Image generation quality: low | medium | high | auto.
# Defaults are the cheapest settings for development/testing.
# For the final run use IMAGE_QUALITY=high and IMAGE_SIZE=1024x1536 (portrait, better for 4:5 posts and 9:16 stories).
IMAGE_QUALITY=high
# Image size passed to the image model (WIDTHxHEIGHT). Backgrounds are cover-cropped to the post canvas by compose.
IMAGE_SIZE=1024x1024

# How product slides get their background: edit | generate.
#   edit     = the product cut-out is placed on the canvas and the image model paints the scene around it
#              (surface, light, shadow); the real product photo is then composited on top, so labels stay exact.
#   generate = the image model paints an empty scene and the product is composited with a drop shadow.
# Slides without a product are always generated. If the model redraws the product instead of keeping it,
# the slide falls back to generate (one extra image call). gpt-image-1-mini usually does that, so with the
# test model edit mostly costs an extra call; gpt-image-2.5-flare keeps the product (RF-001).
BACKGROUND_MODE=edit

# Minimum QA score (0-10) for a post to pass the review stage.
QA_SCORE_THRESHOLD=7
# Max regenerations per post when QA fails.
MAX_REGENERATIONS=1

# SQLite database file (relative paths resolve from the repo root).
DATABASE_PATH=./data/recipe.db
# Where run artifacts are written (runs/<runId>/).
RUNS_DIR=./runs
# API server port (Vite dev server proxies /api to it).
PORT=3001
